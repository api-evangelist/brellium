{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brellium Audits Documents API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.brellium.com/v1/documents",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "metadata",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload a document"
        },
        {
          "info": {
            "name": "Get a presigned URL to upload a large document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.brellium.com/v1/documents/upload-url",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a presigned URL to upload a large document"
        },
        {
          "info": {
            "name": "Get information about a specific document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brellium.com/v1/documents/:document_id",
            "params": [
              {
                "name": "document_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get information about a specific document"
        }
      ]
    }
  ],
  "bundled": true
}